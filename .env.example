# Reference values; set these as PowerShell $env:NAME = "value" before starting.
# No credentials are needed for the software prototype.
FLEET_DATABASE=instance/fleet_mitra.sqlite3
FLEET_HOST=127.0.0.1
FLEET_PORT=5000
FLEET_ROUTING_ENABLED=true
FLEET_ROUTING_TIMEOUT=1.2
FLEET_ROUTE_PLANNING_TIMEOUT=6
FLEET_GEOCODING_ENABLED=true
FLEET_GEOCODING_URL=https://photon.komoot.io/api/
# Optional FLEET_DRIVER_KEY: a Fernet key supplied securely as an environment variable.
# Otherwise a persistent driver-profiles.key is generated beside the database. Back it up.
FLEET_MIN_MOVEMENT_M=5
FLEET_ARRIVAL_RADIUS_M=35
